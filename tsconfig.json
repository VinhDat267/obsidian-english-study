{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "lib": ["DOM", "ES2018"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "obsidian": ["__mocks__/obsidian.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "__mocks__/**/*.ts",
    "main.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
