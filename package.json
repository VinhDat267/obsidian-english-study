{
  "name": "obsidian-polyglot-study",
  "version": "1.1.0",
  "description": "Polyglot & English study assistant for Obsidian - multilingual dictionary lookup, CJK romanization, sentence translation, AI grammar, and contextual vocabulary notebook.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "typecheck:reading": "tsc --project tsconfig.reading.json --noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "polyglot",
    "multilingual",
    "language-learning",
    "english-study",
    "japanese",
    "chinese",
    "korean",
    "dictionary",
    "translation",
    "vocabulary"
  ],
  "author": "Personal",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "jsdom": "26.1.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
